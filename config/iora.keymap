#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        auto_mouse_toggle: auto-mouse-toggle {
            compatible = "askey,auto-mouse-control";
            #binding-cells = <0>;
            display-name = "Auto Mouse Toggle";
        };

        auto_mouse_del: auto-mouse-del {
            compatible = "askey,auto-mouse-control";
            #binding-cells = <0>;
            bindings = <&kp DEL>;
        };

        auto_mouse_f7: auto-mouse-f7 {
            compatible = "askey,auto-mouse-control";
            #binding-cells = <0>;
            bindings = <&lt 1 F7>;
        };
    };

    combos {
        compatible = "zmk,combos";

        auto_mouse_right_click {
            key-positions = <40 41>; /* Space + F7 */
            timeout-ms = <50>;
            layers = <4>;
            bindings = <&mkp RCLK>;
        };

        auto_mouse_middle_click {
            key-positions = <39 40>; /* Del + Space */
            timeout-ms = <50>;
            layers = <4>;
            bindings = <&mkp MCLK>;
        };

        grave {
            key-positions = <0 1>;
            timeout-ms = <50>;
            layers = <0>;
            slow-release;
            bindings = <&kp GRAVE>;
        };

        print_screen {
            key-positions = <10 11>;
            timeout-ms = <50>;
            layers = <0>;
            slow-release;
            bindings = <&kp PRINTSCREEN>;
        };

        home {
            key-positions = <45 46>;
            timeout-ms = <50>;
            layers = <0>;
            slow-release;
            bindings = <&kp HOME>;
        };

        end {
            key-positions = <46 47>;
            timeout-ms = <50>;
            layers = <0>;
            slow-release;
            bindings = <&kp END>;
        };

        left_click {
            key-positions = <15 16>;
            timeout-ms = <50>;
            layers = <0>;
            slow-release;
            bindings = <&mkp LCLK>;
        };

        right_click {
            key-positions = <14 15>;
            timeout-ms = <50>;
            layers = <0>;
            slow-release;
            bindings = <&mkp RCLK>;
        };

        middle_click {
            key-positions = <14 15 16>;
            timeout-ms = <50>;
            layers = <0>;
            slow-release;
            bindings = <&mkp MCLK>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "Layer 0";
            bindings = <
                &kp ESC  &kp Q  &kp W  &kp E  &kp R  &kp T                     &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC
                &kp TAB  &kp A  &kp S  &kp D  &kp F  &kp G                     &kp H  &kp J  &kp K  &kp L  &kp SLASH  &kp ENTER
                &kp LSHIFT  &kp Z  &kp X  &kp C  &kp V  &kp B                  &kp N  &kp M  &kp COMMA  &kp DOT  &kp UP  &kp RSHIFT
                &kp LCTRL  &kp LGUI  &kp LALT  &kp DEL  &kp SPACE  &lt 1 F7    &lt 2 F10  &none  &kp MINUS  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        layer_1 {
            display-name = "Layer 1";
            bindings = <
                &bootloader  &none  &none  &none  &none  &none    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS  &kp EQUAL  &kp INTERNATIONAL_3
                &none  &none  &none  &none  &none  &none          &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &none  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
                &none  &none  &none  &none  &none  &none          &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SEMICOLON  &kp SINGLE_QUOTE  &kp NON_US_HASH
                &auto_mouse_toggle  &none  &none  &none  &kp LSHIFT  &none    &none  &kp NUMBER_0  &kp DOT  &none  &none  &kp INTERNATIONAL_1
            >;
        };

        layer_2 {
            display-name = "Layer 2";
            bindings = <
                &none  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                                       &none  &none  &none  &none  &none  &bootloader
                &none  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10                                      &none  &none  &none  &none  &none  &none
                &none  &kp F11  &kp F12  &none  &none  &none                                        &none  &none  &none  &none  &none  &none
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR    &none  &none  &none  &none  &none  &studio_unlock
            >;
        };

        layer_3 {
            display-name = "Layer 3";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            display-name = "Auto Mouse";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &auto_mouse_del  &mkp LCLK  &auto_mouse_f7    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            display-name = "Trackball Settings";
            bindings = <
                &kp C_VOL_UP  &kp C_VOL_DN  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &kp C_VOL_UP  &kp C_VOL_DN  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &kp C_VOL_UP  &kp C_VOL_DN  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
