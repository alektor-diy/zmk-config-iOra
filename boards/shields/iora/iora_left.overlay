#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include "iora.dtsi"

/ {
    iora_auto_mouse: iora-auto-mouse {
        compatible = "askey,auto-mouse";
        #input-processor-cells = <0>;
        processor = <&zip_temp_layer 4 800>;
    };

    iora_trackball_keys: iora-trackball-keys {
        compatible = "askey,trackball-keys";
        #input-processor-cells = <0>;
        layers = <1 2 3>;
        settings-layer = <5>;
        up-positions = <0 12 24>;
        down-positions = <1 13 25>;
        counts-per-tap = <48>;
        repeat-interval-ms = <40>;
    };

    left_trackball_listener: left-trackball-listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        input-processors = <&iora_trackball_keys>,
                           <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
                           <&zip_xy_scaler 1 16>,
                           <&zip_xy_to_scroll_mapper>;
    };

    right_trackball_listener: right-trackball-listener {
        compatible = "zmk,input-listener";
        device = <&right_trackball_split>;
        input-processors = <&iora_auto_mouse>;

        scroll {
            layers = <1 2 3>;
            input-processors = <&iora_auto_mouse>,
                               <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
                               <&zip_xy_scaler 1 16>,
                               <&zip_xy_to_scroll_mapper>;
        };
    };
};

&zip_temp_layer {
    require-prior-idle-ms = <200>;
    excluded-positions = <39 40 41>; /* Del, Space, F7 */
};

&trackball {
    x-invert;
    y-invert;
};
